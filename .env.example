# ============================================================ PenpotOS configuration
# Copy to .env and fill in. Generate secrets e.g. with:  openssl rand -hex 32

# Public address of Penpot as members (and Claude) will reach it – the Cloudflare Tunnel hostname.
# Must be HTTPS for the Claude connector (OAuth). Example: https://penpot.voluntia.cz
PENPOTOS_PUBLIC_URL=http://localhost:9001

# --- secrets (REQUIRED, keep them safe; changing PENPOTOS_SECRET_KEY invalidates stored API keys)
POSTGRES_PASSWORD=
PENPOT_SECRET_KEY=
PENPOTOS_SECRET_KEY=
PENPOTOS_INTERNAL_TOKEN=

# --- first administrator (created on first start; later manage users in the dashboard)
PENPOTOS_ADMIN_EMAIL=admin@example.com
PENPOTOS_ADMIN_PASSWORD=
PENPOTOS_ADMIN_NAME=Administrátor

# --- ports on the ZimaOS host
PENPOTOS_GATEWAY_PORT=9001
PENPOTOS_ADMIN_PORT=9002
# Set to 127.0.0.1 to make the admin dashboard reachable only from the server itself (e.g. via SSH tunnel)
PENPOTOS_ADMIN_BIND=0.0.0.0

# --- Cloudflare Tunnel (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# --- AI service account (the Penpot user under which the AI edits designs)
PENPOTOS_BOT_EMAIL=ai@penpotos.local
PENPOTOS_BOT_NAME=Voluntia AI

# --- Penpot
PENPOT_VERSION=2.18
# When Penpot is served ONLY over HTTPS you can switch to secure cookies:
# PENPOT_SESSION_COOKIE_FLAG=enable-secure-session-cookies
PENPOT_EXTRA_FLAGS=

# --- optional SMTP (password recovery e-mails, notifications)
PENPOT_SMTP_HOST=
PENPOT_SMTP_PORT=587
PENPOT_SMTP_USERNAME=
PENPOT_SMTP_PASSWORD=
PENPOT_SMTP_TLS=true
PENPOT_SMTP_DEFAULT_FROM=no-reply@example.com

TZ=Europe/Prague
LOG_LEVEL=info
PENPOTOS_VERSION=latest

# Hosts with IPv6 disabled: uncomment if penpot-frontend keeps restarting with "Address family not supported"
# PENPOT_IPV6_LISTEN_DIRECTIVE=#
